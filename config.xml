<?xml version='1.0' encoding='utf-8'?>
<widget id="gt.edu.tiendasanjose" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Tienda San José</name>
  <description>Aplicación móvil de ventas para Tienda San José.</description>
  <author email="alumno@example.com" href="https://cordova.apache.org">Proyecto de clase</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="AndroidXEnabled" value="true" />
